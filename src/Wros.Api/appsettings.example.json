{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=Wros;User Id=YOUR_SQL_USER;Password=SET_VIA_USER_SECRETS_OR_ENV;Encrypt=True;TrustServerCertificate=False;Persist Security Info=False"
  },
  "Jwt": {
    "Issuer": "wros-local",
    "Audience": "wros-web",
    "AccessTokenMinutes": 15
  },
  "Integration": {
    "AllowedClients": [],
    "Audience": "https://localhost:7243/api/v1/integration",
    "SnapshotMinutes": 30,
    "MaxSnapshotRows": 100000,
    "Clients": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Fatal",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR_FRONTEND_HOST"
    ]
  },
  "Seed": {
    "Enabled": false,
    "SampleDataEnabled": false
  },
  "ProductionAdminSeed": {
    "Enabled": false,
    "UserName": "",
    "Password": ""
  },
  "Inventory": {
    "ExpiryAlertDays": 30
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Authentication": {
    "SessionMinutes": 15,
    "CrossSiteCookies": false
  },
  "SupplierImport": {
    "MaxFileBytes": 5242880,
    "MaxExpandedBytes": 33554432,
    "MaxRows": 2000,
    "MaxColumns": 64,
    "AllowedExtensions": [
      ".xlsx"
    ],
    "DefaultCurrency": "KWD",
    "PreviewHours": 24
  },
  "PurchaseOrderPrint": {
    "PageSize": "A4",
    "MarginMillimeters": 12,
    "HeaderAssetPath": null,
    "FooterAssetPath": null
  }
}
