{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "wros-local",
    "Audience": "wros-web",
    "AccessTokenMinutes": 15
  },
  "Integration": {
    "AllowedClients": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Fatal",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Enabled": false,
    "SampleDataEnabled": false
  },
  "Inventory": {
    "ExpiryAlertDays": 30
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
