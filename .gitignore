**/[Oo]bj/
/artifacts/
/publish/
*.nupkg
*.snupkg

# React / Vite / TypeScript (keep package-lock.json)
**/node_modules/
**/dist/
**/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE settings
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Local environment files and secrets (keep non-secret examples)
.env
.env.*
!.env.example
!.env.*.example
**/appsettings.Local.json
**/appsettings.*.Local.json
**/appsettings.Secrets.json
**/appsettings.*.Secrets.json
**/secrets.json
*.pfx
*.p12
*.pem
*.key

# Local SQL Server data and database backups
*.mdf
*.ndf
*.ldf
*.bak
*.bacpac

# Runtime logs
logs/
*.log

# macOS / Windows / editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# ZIP archives
*.[zZ][iI][pP]

# Private Development account passwords (editable C# seed file)
**/DevelopmentSeedCredentials.local.cs
